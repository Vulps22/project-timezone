# Copy this file to .env and fill in your values

# --- Discord (required) ---
DISCORD_TOKEN=your_discord_bot_token_here

# --- Postgres (required) ---
# Either a full connection URL...
DATABASE_URL=postgres://timezone:password@localhost:5432/timezone
# ...or leave DATABASE_URL unset and use the standard PG* variables instead:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=timezone
# PGPASSWORD=password
# PGDATABASE=timezone

# Connections per shard process (total = shards x this). Default 5
DATABASE_POOL_SIZE=5
# Set to true for hosted Postgres that requires TLS
DATABASE_SSL=false
# Set to false only if your provider uses a self-signed certificate
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# --- Logging (optional) ---
DISCORD_LOG_CHANNEL=your_log_channel_id
DISCORD_ERROR_CHANNEL=your_error_channel_id
DISCORD_LOGGER_WEBHOOK=your_webhook_url

# --- Environment ---
NODE_ENV=production

# --- Tests only (optional) ---
# Enables the database tests. ALL DATA IN IT IS WIPED, never use production.
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/timezone_test

# --- One-off SQLite -> Postgres migration (optional) ---
# SQLITE_PATH=./database/timezone.db
